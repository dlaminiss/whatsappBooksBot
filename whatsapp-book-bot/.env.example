# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Path to the SQLite database file (created automatically if it doesn't exist)
DB_PATH=./books.db

# Optional: comma-separated list of phone numbers (with country code, no +, no spaces)
# allowed to use the bot, e.g. 15551234567,447911123456
# Leave empty to allow anyone who messages the bot.
ALLOWED_NUMBERS=

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-6